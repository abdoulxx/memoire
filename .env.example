# Copier en .env (non suivi par git). Aucun secret dans le depot : CLAUDE.md 4.3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROMETHEUS_URL=
MLFLOW_TRACKING_URI=
LLM_API_KEY=

# --- Pile Docker Compose du jalon M4 (docker-compose.yml) ---
# Adresse d'ecoute des ports publies. 127.0.0.1 = rien n'est joignable depuis
# l'exterieur du serveur (acces par tunnel SSH). Ne mettre 0.0.0.0 qu'en
# connaissance de cause.
BIND_ADDR=127.0.0.1

# Ports publies. A decaler si le serveur fait deja tourner quelque chose sur
# ces ports : le §4.3 interdit de toucher aux conteneurs des autres, donc c'est
# cette pile qui cede la place.
APP_PORT=8000
PROM_PORT=9090
GRAFANA_PORT=3000
MLFLOW_PORT=5000

# Grafana refuse de demarrer si le mot de passe n'est pas renseigne : c'est
# voulu, un defaut « admin » sur un serveur accessible n'est pas acceptable.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Deploiement courant de l'appli de test. Changer APP_VERSION et
# APP_BASE_LATENCY_MS puis relancer le service EST la derive reelle S1 (§5) :
# ces valeurs sont ici, et non dans configs/, pour qu'injecter une derive ne
# demande pas un commit.
APP_VERSION=1.0.0
APP_BASE_LATENCY_MS=25
APP_LATENCY_SPREAD=0.35
APP_CHAOS_ENABLED=1

# Bornes de l'appli de test : sa saturation doit rester la sienne.
APP_CPUS=1.0
APP_MEMORY=512m

# Retention Prometheus, bornee en duree ET en taille (§4.3 : surveiller la
# retention et l'espace disque).
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=4GB

# Appli de test vue par l'injecteur d'anomalies (infra/injector). A renseigner
# si APP_PORT n'est pas 8000 : l'injecteur refuse d'injecter dans une URL qui ne
# repond pas comme l'appli de test (verification de cible), mais mieux vaut lui
# donner la bonne des le depart. Cette variable a la priorite sur
# configs/injection.yaml.
MEMOIRE_APP_URL=http://127.0.0.1:8000

# --- Registre de modeles (jalon M5) ---
# MLFLOW_TRACKING_URI (en haut de ce fichier) a la priorite sur
# configs/serving.yaml. Avec la pile Compose locale :
#   MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# A renseigner si MLFLOW_PORT est decale, sinon le service de detection
# interrogerait un registre qui n'est pas celui qui tourne.
#
# Bornes du conteneur mlflow. Le registre tient la tracabilite de la campagne :
# il est borne pour qu'une fuite de son cote n'emporte pas le serveur.
MLFLOW_CPUS=1.0
MLFLOW_MEMORY=1g
